# Cadena de conexión a Postgres de Supabase (Project Settings > Database > Connection string, botón Connect, método Session pooler:
SUPABASE_DB_URL=postgresql://postgres.PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres

# API local de prueba. Reemplazar por el API desplegado cuando esté disponible.
# Usar dev-cache-key al ejecutar el Zonal Cache y dev-interceptor-key para el Interceptor.
NODE_API_URL=http://127.0.0.1:8787
NODE_API_KEY=dev-interceptor-key
NODE_API_TIMEOUT_SECONDS=5

# just up (T-25): llaves de componente que Helm guarda en un Secret para el Interceptor y las cachés.
# Las de desarrollo son las de supabase/seed.sql. NODE_API_URL tiene que ser el API desplegado en Cloudflare
# (https://zonal-api.duran-munozalonso.workers.dev), porque la EC2 no llega a 127.0.0.1 de esta compu.
LLAVE_INTERCEPTOR=dev-interceptor-key
LLAVE_CACHE=dev-cache-key

# Zonal Cache. Montar los archivos de la CA en las rutas indicadas.
CACHE_PORT=8080
CACHE_TLS_PORT=8443
TLS_CA_CERT_FILE=/etc/zonal-cache/rootCA.pem
TLS_CA_KEY_FILE=/etc/zonal-cache/rootCA-key.pem
CONFIG_REFRESH_SECONDS=30
PURGE_INTERVAL_SECONDS=60
# Formulario de la UI para las URLs con user_password (T-14)
UI_LOGIN_URL=http://localhost:5173/login

# Interceptor DNS. Valores de desarrollo, sin credenciales de producción.
DNS_PORT=5300
UPSTREAM_DNS=8.8.8.8
UPSTREAM_DNS_PORT=53
UPSTREAM_TIMEOUT_SECONDS=3
DNS_TTL_SECONDS=60

# Terraform (T-24). Credenciales de AWS: con `aws configure`, o estas tres variables
# (en AWS Academy salen de AWS Details > AWS CLI y cambian cada vez que se inicia el lab).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# IP pública de cada integrante con /32 (https://checkip.amazonaws.com). Solo ellas llegan al API de Kubernetes.
# Va entre comillas simples: sin ellas se pierden las comillas dobles y Terraform no la lee como lista
TF_VAR_ips_equipo='["201.191.10.20/32"]'
# En AWS Academy no se pueden crear roles; se usa el perfil que ya trae el lab
# TF_VAR_perfil_instancia=LabInstanceProfile
