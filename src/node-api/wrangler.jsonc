{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zonal-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Orígenes de la UI: Vite en local y Cloudflare Pages (proyecto zonal-ui)
  "vars": {
    "UI_ORIGINS": "http://localhost:5173,https://zonal-ui.pages.dev",
    // Duración de las sesiones: 1 hora
    "SESSION_TTL_SECONDS": "3600"
  },
  // wrangler preview (deploy de cada PR) no hereda "vars": se repiten aquí
  "previews": {
    "vars": {
      "UI_ORIGINS": "http://localhost:5173,https://zonal-ui.pages.dev",
      "SESSION_TTL_SECONDS": "3600"
    }
  }
}
