# Variables de la UI. Copiar a .env.local (git lo ignora) y llenar. Vite solo expone las que empiezan con VITE_,
# y todo lo que va aquí termina en el JavaScript que baja el navegador: nunca poner la secret ni la service_role.

# Supabase: Project Settings > API
VITE_SUPABASE_URL=https://PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# REST API Node.js (Cloudflare Worker) y su llave con alcance ui (dev-ui-key en los datos de prueba)
VITE_API_URL=https://zonal-api.duran-munozalonso.workers.dev
VITE_API_KEY=dev-ui-key
